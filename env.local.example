# PhotonDoq — Variáveis de ambiente
# Copia este ficheiro para .env.local e preenche os valores

# Anthropic API Key (obrigatório)
ANTHROPIC_API_KEY=sk-ant-api03-...

# URL pública da app (para CORS)
NEXT_PUBLIC_APP_URL=https://app.photondoq.pt

# Neon PostgreSQL (fase 3)
# DATABASE_URL=postgresql://...

# Upstash Redis (fase 3)
# REDIS_URL=rediss://...

# Stripe (fase 4)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
